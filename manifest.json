{
  "manifest_version": 3,
  "name": "Theme Studio for GitHub - Themes & Anime Backgrounds",
  "short_name": "GitHub Theme Studio",
  "version": "1.0.0",
  "description": "Customize your GitHub experience with curated themes, code syntax highlighting, aesthetic wallpapers, custom contribution graphs, celebrations & focus mode.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://*.github.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Theme Studio for GitHub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.github.com/*"
      ],
      "css": [
        "content/theme-engine.css"
      ],
      "js": [
        "content/themes.js",
        "content/confetti.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-focus-mode": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Toggle Theme Studio Focus Mode (Clean presentation view)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*",
        "assets/wallpapers/*"
      ],
      "matches": [
        "https://github.com/*",
        "https://*.github.com/*"
      ]
    }
  ]
}
